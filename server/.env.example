# ---------------------------------------------------------------------------
# Side MyProject API - environment variables
# Copy to .env for local development. On Railway set these in the service's Variables tab.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# "production" on Railway. Enables fail-fast checks and the storage warning.
NODE_ENV=development
# Railway injects PORT automatically; 3001 locally.
PORT=3001
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Postgres connection string. On Railway reference the Postgres plugin: ${{Postgres.DATABASE_URL}}
# (Fallbacks also read: RAILWAY_DATABASE_URL, POSTGRES_URL, or PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/side_myproject
# SSL is on automatically in production for non-local/non-*.railway.internal hosts.
# Force on/off with DATABASE_SSL=true|false (or PGSSLMODE=require).
# DATABASE_SSL=
# Optional pool tuning
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT=30000
# PG_CONNECT_TIMEOUT=10000

# --- Auth --------------------------------------------------------------------
# REQUIRED in production (server refuses to boot without it). Long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=
# Token lifetime (jsonwebtoken format)
JWT_EXPIRES_IN=24h

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins (exact match).
# Vercel previews matching ^https://side-my-project[-a-z0-9]*\.vercel\.app$ are always allowed.
# Default when empty: http://localhost:5173 in development, nothing extra in production.
CORS_ORIGINS=http://localhost:5173

# --- Image storage (READ THIS) -----------------------------------------------
# Railway's container filesystem is EPHEMERAL: files written to disk are deleted on every
# deploy/restart. Pick ONE of these, otherwise every uploaded image is lost on the next deploy
# (the server logs a WARN at boot in production when neither is configured):
#
#   (A) RECOMMENDED - Cloudinary. Set CLOUDINARY_URL (Cloudinary dashboard -> API Keys ->
#       "API environment variable"). Images go to folder "side-myproject/..." and the DB stores
#       the https URL.
#   (B) Railway Volume. Create a Volume on the API service, mount it at e.g. /data/uploads,
#       and set UPLOAD_DIR=/data/uploads. Files are served from /uploads/...
#
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Local/Volume directory for uploads when CLOUDINARY_URL is empty. Default: server/uploads
UPLOAD_DIR=

# --- Public URLs ------------------------------------------------------------
# Public origin of THIS API, used to make /uploads/... image paths absolute
# (author_avatar_url, POST /api/uploads/image). Empty = use the request's protocol + host
# (works behind Railway's proxy because trust proxy is enabled).
# PUBLIC_API_URL=https://side-myproject-production.up.railway.app
PUBLIC_API_URL=

# --- Password reset email ----------------------------------------------------
# Public URL of the frontend; used to build reset links.
APP_BASE_URL=http://localhost:5173
# Optional full override of the reset page base URL (the token is appended as /<token>).
# Default: ${APP_BASE_URL}/reset-password  -> link = ${APP_BASE_URL}/reset-password/<token>
# PASSWORD_RESET_URL=
# SMTP for forgot-password emails. If SMTP_HOST/SMTP_USER/SMTP_PASS are missing, no email is
# sent; outside production the reset link is logged at info level (without the email address).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Seed (npm run seed - dev/demo only, create-if-missing, never resets passwords) ---------
# Demo accounts shown on the public Login/Admin-login/Help pages. Defaults keep the demo working.
# ADMIN_EMAIL=chayanon.5723@gmail.com
# ADMIN_PASSWORD=ppond333
# DEMO_ADMIN_EMAIL=admin@example.com
# DEMO_ADMIN_PASSWORD=admin123
# DEMO_USER_EMAIL=some@gmail.com
# DEMO_USER_PASSWORD=ppond333

# --- One-off image migration (scripts/migrate-uploads-to-cloudinary.js) ------------------
# Origin of the OLD API that still serves the /uploads files, e.g.
# SOURCE_BASE_URL=https://side-myproject-production.up.railway.app
